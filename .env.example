# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.

# Chave longa e aleatória para assinar as sessões de login.
SECRET_KEY=troque-por-uma-chave-aleatoria

# Supabase > Connect > "Transaction pooler" (porta 6543). Copie a string do painel
# e troque [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API Keys (usadas só para guardar as imagens das trilhas).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
